/target
node_modules
*.node
.env
.env.*
.DS_Store
dist
build
*.log
.superpowers
.sai/

# local raw .zevtc fixtures (contain real account names — never commit)
/fixtures/local

# Python SDK (crates/axilog-py) build venv/artifacts -- created locally by
# `python3 -m venv .venv && pip install maturin && maturin develop`, never
# committed.
crates/axilog-py/.venv/
*.egg-info/
__pycache__/
*.pyc

# generated reports at repo root (contain real player names — never commit)
/*.html

# stray browser-session dumps from the Playwright MCP tool -- never committed
.playwright-mcp/

# SDD isolated worktrees (scratch, never committed)
.worktrees/

# Raw .zevtc drops carry real account names. Only anonymized copies are
# committed, and they are named for it -- see fixtures/pve. This is a rule
# rather than a per-folder entry because the drops arrive under whatever
# name they were dragged in under, and an un-ignored one is a PII leak.
/fixtures/**/*.zevtc
!/fixtures/**/*.anon.zevtc
